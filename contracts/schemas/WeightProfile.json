{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "ownerId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "isDefault": {
      "type": "boolean"
    },
    "weights": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "customers",
          "severity",
          "satisfaction_gap",
          "competitor_gap",
          "market_volume",
          "regression",
          "trend",
          "brand_fit"
        ]
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "required": [
        "customers",
        "severity",
        "satisfaction_gap",
        "competitor_gap",
        "market_volume",
        "regression",
        "trend",
        "brand_fit"
      ]
    },
    "costMultiplier": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "S",
          "M",
          "L"
        ]
      },
      "additionalProperties": {
        "type": "number"
      },
      "required": [
        "S",
        "M",
        "L"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "ownerId",
    "isDefault",
    "weights",
    "costMultiplier"
  ],
  "additionalProperties": false
}