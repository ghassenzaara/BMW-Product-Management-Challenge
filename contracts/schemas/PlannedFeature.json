{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "carArea": {
      "type": "string",
      "enum": [
        "exterior_design",
        "interior_comfort",
        "seats",
        "climate",
        "infotainment_hmi",
        "connectivity_digital",
        "driver_assistance",
        "dynamics_powertrain",
        "range_charging",
        "practicality",
        "quality_materials"
      ]
    },
    "name": {
      "type": "string"
    },
    "today": {
      "type": "string",
      "enum": [
        "standard",
        "optional",
        "absent",
        "removed"
      ]
    },
    "todayDetail": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "keep",
        "new",
        "improve",
        "remove"
      ]
    },
    "requirementIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "release": {
      "type": "string",
      "enum": [
        "next_gen",
        "lci",
        "ota"
      ]
    },
    "protected": {
      "type": "boolean"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "carArea",
    "name",
    "today",
    "todayDetail",
    "action",
    "requirementIds",
    "release",
    "protected",
    "note"
  ],
  "additionalProperties": false
}