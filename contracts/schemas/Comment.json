{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "objectType": {
      "type": "string",
      "enum": [
        "case",
        "requirement"
      ]
    },
    "objectId": {
      "type": "string",
      "minLength": 1
    },
    "authorId": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "string"
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "createdAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "objectType",
    "objectId",
    "authorId",
    "body",
    "mentions",
    "createdAt"
  ],
  "additionalProperties": false
}