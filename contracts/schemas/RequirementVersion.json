{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requirementId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "shortTitle": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "descriptionParts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "marketScope": {
          "type": "string",
          "enum": [
            "global",
            "RoW",
            "CN"
          ]
        },
        "releaseTarget": {
          "type": "string",
          "enum": [
            "next_gen",
            "lci",
            "ota"
          ]
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "question": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "today": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "basis": {
                "type": "string",
                "enum": [
                  "evidence",
                  "assumption"
                ]
              },
              "benchmark": {
                "type": "string"
              },
              "targetSpec": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "enum": [
                      "ev_range",
                      "dc_10_80_min"
                    ]
                  },
                  "comparator": {
                    "type": "string",
                    "enum": [
                      "gte",
                      "lte"
                    ]
                  },
                  "value": {
                    "type": "number"
                  },
                  "unit": {
                    "type": "string"
                  },
                  "cycle": {
                    "type": "string",
                    "enum": [
                      "WLTP",
                      "CLTC",
                      "EPA",
                      "none"
                    ]
                  },
                  "market": {
                    "type": "string",
                    "enum": [
                      "global",
                      "EU",
                      "US",
                      "CN",
                      "RoW"
                    ]
                  }
                },
                "required": [
                  "key",
                  "comparator",
                  "value",
                  "unit",
                  "cycle",
                  "market"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "question",
              "target",
              "basis"
            ],
            "additionalProperties": false
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceLevel": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "assumption"
          ]
        },
        "cost": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string",
              "enum": [
                "S",
                "M",
                "L"
              ]
            },
            "eurBand": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "enum": [
                "option_price",
                "ai_estimate",
                "pm",
                "engineering",
                "finance"
              ]
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "size",
            "eurBand",
            "source",
            "note"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "enum": [
                  "evidence",
                  "pm_context",
                  "assumption"
                ]
              },
              "layer": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "brand",
                      "series_brief",
                      "case_stance",
                      "requirement_shape",
                      "feedback"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "signalIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "source",
              "layer",
              "ref",
              "signalIds",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "shapeAnswers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "enum": [
                  "scope",
                  "benchmark",
                  "solution",
                  "release",
                  "offer"
                ]
              },
              "value": {
                "type": "string"
              },
              "byDefault": {
                "type": "boolean"
              }
            },
            "required": [
              "key",
              "value",
              "byDefault"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "shortTitle",
        "description",
        "descriptionParts",
        "marketScope",
        "releaseTarget",
        "metrics",
        "acceptanceCriteria",
        "assumptions",
        "evidenceLevel",
        "cost",
        "provenance",
        "shapeAnswers"
      ],
      "additionalProperties": false
    },
    "cause": {
      "type": "string",
      "enum": [
        "draft",
        "feedback",
        "brief_change",
        "edit",
        "ripple"
      ]
    },
    "feedbackId": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "createdBy": {
      "type": "string"
    }
  },
  "required": [
    "requirementId",
    "version",
    "snapshot",
    "cause",
    "rationale",
    "createdAt",
    "createdBy"
  ],
  "additionalProperties": false
}