{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "series": {
      "type": "string",
      "enum": [
        "G60",
        "F70",
        "G70"
      ]
    },
    "title": {
      "type": "string"
    },
    "shortTitle": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "descriptionParts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "evidence",
              "pm_context",
              "assumption"
            ]
          },
          "layer": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "brand",
                  "series_brief",
                  "case_stance",
                  "requirement_shape",
                  "feedback"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "signalIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "source",
          "layer",
          "ref",
          "signalIds",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "version": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "shapeAnswers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "scope",
              "benchmark",
              "solution",
              "release",
              "offer"
            ]
          },
          "value": {
            "type": "string"
          },
          "byDefault": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "value",
          "byDefault"
        ],
        "additionalProperties": false
      }
    },
    "briefId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "drafter": {
      "type": [
        "string",
        "null"
      ]
    },
    "marketScope": {
      "type": "string",
      "enum": [
        "global",
        "RoW",
        "CN"
      ]
    },
    "variantOf": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_discussion",
        "pm_approved",
        "signed_off",
        "planned",
        "exported",
        "rejected"
      ]
    },
    "releaseTarget": {
      "type": "string",
      "enum": [
        "next_gen",
        "lci",
        "ota"
      ]
    },
    "carArea": {
      "type": "string",
      "enum": [
        "exterior_design",
        "interior_comfort",
        "seats",
        "climate",
        "infotainment_hmi",
        "connectivity_digital",
        "driver_assistance",
        "dynamics_powertrain",
        "range_charging",
        "practicality",
        "quality_materials"
      ]
    },
    "changeDepth": {
      "type": "string",
      "enum": [
        "trim_option",
        "part_module",
        "platform_powertrain",
        "software_ota"
      ]
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "today": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "basis": {
            "type": "string",
            "enum": [
              "evidence",
              "assumption"
            ]
          },
          "benchmark": {
            "type": "string"
          },
          "targetSpec": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "enum": [
                  "ev_range",
                  "dc_10_80_min"
                ]
              },
              "comparator": {
                "type": "string",
                "enum": [
                  "gte",
                  "lte"
                ]
              },
              "value": {
                "type": "number"
              },
              "unit": {
                "type": "string"
              },
              "cycle": {
                "type": "string",
                "enum": [
                  "WLTP",
                  "CLTC",
                  "EPA",
                  "none"
                ]
              },
              "market": {
                "type": "string",
                "enum": [
                  "global",
                  "EU",
                  "US",
                  "CN",
                  "RoW"
                ]
              }
            },
            "required": [
              "key",
              "comparator",
              "value",
              "unit",
              "cycle",
              "market"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "question",
          "target",
          "basis"
        ],
        "additionalProperties": false
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceLevel": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "assumption"
      ]
    },
    "cost": {
      "type": "object",
      "properties": {
        "size": {
          "type": "string",
          "enum": [
            "S",
            "M",
            "L"
          ]
        },
        "eurBand": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "option_price",
            "ai_estimate",
            "pm",
            "engineering",
            "finance"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "size",
        "eurBand",
        "source",
        "note"
      ],
      "additionalProperties": false
    },
    "ownerId": {
      "type": "string",
      "minLength": 1
    },
    "manualRank": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "plannedFeatureId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "sentBackReason": {
      "type": "string"
    },
    "argumentMd": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "caseId",
    "series",
    "title",
    "shortTitle",
    "description",
    "descriptionParts",
    "provenance",
    "version",
    "shapeAnswers",
    "briefId",
    "drafter",
    "marketScope",
    "variantOf",
    "status",
    "releaseTarget",
    "carArea",
    "changeDepth",
    "metrics",
    "acceptanceCriteria",
    "assumptions",
    "evidenceLevel",
    "cost",
    "ownerId",
    "manualRank",
    "plannedFeatureId",
    "createdAt",
    "updatedAt",
    "synthetic"
  ],
  "additionalProperties": false
}