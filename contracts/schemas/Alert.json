{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "ownerId": {
      "type": "string",
      "minLength": 1
    },
    "caseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "requirementId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "supports",
        "contradicts",
        "raises_the_bar"
      ]
    },
    "title": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "signalIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "dismissed",
        "rework"
      ]
    },
    "resolution": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "rippleId": {
      "type": "string",
      "minLength": 1
    },
    "itemVerdict": {
      "type": "string",
      "enum": [
        "behind",
        "at_par",
        "still_ahead",
        "not_comparable"
      ]
    },
    "comparison": {
      "type": "object",
      "properties": {
        "ours": {
          "type": "string"
        },
        "theirs": {
          "type": "string"
        },
        "normalized": {
          "type": "string"
        },
        "factor": {
          "type": [
            "number",
            "null"
          ]
        },
        "isAssumption": {
          "type": "boolean"
        }
      },
      "required": [
        "ours",
        "theirs",
        "normalized",
        "factor",
        "isAssumption"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "ownerId",
    "caseId",
    "requirementId",
    "verdict",
    "title",
    "detail",
    "signalIds",
    "status",
    "createdAt"
  ],
  "additionalProperties": false
}