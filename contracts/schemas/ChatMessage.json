{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "objectType": {
      "type": "string",
      "enum": [
        "case",
        "requirement"
      ]
    },
    "objectId": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ]
    },
    "authorId": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "string"
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "ref",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "proposalIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "createdAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "objectType",
    "objectId",
    "role",
    "content",
    "citations",
    "proposalIds",
    "createdAt"
  ],
  "additionalProperties": false
}