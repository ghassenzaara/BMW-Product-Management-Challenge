flowchart TB
    %% =========================================================
    %% BMW Requirements Platform: target architecture
    %% SIGNAL = every piece of evidence (one statement about one feature from one source record)
    %% CASE = the problem (what customers / market say), composed of a group of signals
    %% REQUIREMENT = what BMW builds, generated only after the PM confirms a case
    %% Brain = background pipeline (daily, no PM needed)
    %% Dotted arrows to AUDIT = every step writes an audit event
    %% =========================================================

    %% ---------- 0. Configuration ----------
    subgraph CFG ["0 · Configuration (per vehicle + market, never hardcoded)"]
        direction LR
        CF1["Vehicle + market<br>valid only if sales volume > 0"]
        CF2["Competitor set<br>default list, AI suggests, PM confirms"]
        CF3["BMW brand profile<br>versioned assumption, editable by PM"]
        CF4["Source filter<br>include / exclude source types"]
        CF5["Weight profiles<br>several per vehicle, e.g. focus speed / budget"]
    end

    %% ---------- 1. Seeding ----------
    subgraph SEED ["1 · Seed the database (one-time import, logged)"]
        direction LR
        B1["Current BMW model = predecessor of successor<br>option lists PDF, extracted once and verified:<br>SA code, name, price, standard / optional per variant,<br>customer-facing tech data e.g. range, charging kW"]
        B2["BMW portfolio<br>segment, generation, markets sold,<br>shared Baukasten features"]
        B3["Sales volumes<br>2030 forecast = market weight"]
        B4["Customer study 2025<br>raw + normalized 0..1,<br>US dissatisfied share"]
        B6["BMW customer feedback Excel<br>converted to signal records"]
        B5["Fixed taxonomy = feature catalog (taxonomy/)<br>219 topics (BMW VFC level 2) · 11 aspect groups · 11 car areas<br>one feature per topic; option codes and study attributes mapped to topics"]
        B7{"Human check by team<br>option list + the two topic mappings confirmed<br>only a human changes the taxonomy"}
        B1 & B2 & B3 & B4 & B6 --> B5 --> B7
    end
    PRED["On-demand predecessor research<br>PM flags 'removed vs older generation' → case tag + decision<br>background run fetches the predecessor's pages,<br>signals tagged predecessor, line rescored"]

    %% ---------- 2. Background agent loop ----------
    subgraph LOOP ["2 · Daily fetch loop (Python worker + cron, daily budget + priority)<br>v1 = fetch steps 1 to 9 · one backfill over all pages, then daily incremental"]
        direction LR
        A1["Competitor agent<br>launches J · competitor equipment E"]
        A2["Customer + public feedback agent<br>complaints A · reviews B · community C ·<br>expert + video D · apps H"]
        A3["Trends agent<br>market, studies, trends F G I"]
        A4["Innovation scout<br>other industries, suppliers, CES"]
    end
    SRCNOTE["Sources: docs/05-web-sources/fetching-sources.md<br>categories A..J, fetch order, record format<br>adapters: APIs · feeds · forums · review + complaint sites ·<br>model pages · newsrooms · market pages · libraries (Play, Trends)<br>polite client: robots.txt, delay, budget, raw response stored first<br>a general search provider only for discovery, pluggable"]
    SRCNOTE -.-> LOOP

    SNAP[("Source records<br>raw response + record fields<br>text records 7.2 · data records 7.3")]

    %% ---------- 3. Signal record ----------
    subgraph NORM ["3 · Signal record (signal = every piece of evidence, versioned JSON contract)"]
        direction TB
        J1["signal JSON signal@2, one statement about one topic<br>source + published_at · subject + generation tag<br>market USA / China / Europe / RoW / unknown + basis<br>vehicle_role · evidence_role bmw_customer / competitor / market · author_hash<br>kind · severity · topic_id + aspect_group from closed lists (enums)<br>car area derived from the topic in code, never predicted<br>summary ≤ 20 words EN · exact quote + EN translation<br>reach + unit · competitor_fact structured · extra"]
        J2{"Validation gate<br>schema · stored record · quote found · known topic + aspect group ·<br>duplicate · dated competitor fact · scope tag (price = out of scope)"}
        J4[("Taxonomy review queue<br>topic 'other' or low confidence<br>PM maps to an existing topic or dismisses;<br>no topic is ever created automatically")]
        J2 -- "other / low confidence" --> J4
        J3[("Quarantine<br>rejected + reason, visible count<br>PM delete = content purged, tombstone in audit")]
        J1 --> J2
    end

    %% ---------- 4. Cases ----------
    subgraph SC ["4 · Group signals into CASES (case = problem, composed of a group of signals;<br>one case can apply to several BMW lines, each line's PM works it)"]
        direction TB
        S1["Topic first<br>BMW rows: lookup from VFC labels · web: LLM picked from closed list<br>no topic yet → LLM classifier before grouping, never a similarity guess"]
        S2["Case = topic + aspect group<br>only groups ≥ 50 signals split by summary similarity,<br>never across a topic · stable IDs, merges / splits logged"]
        S3["Case figures per vehicle<br>all opinions in one case: complaints · wishes · likes<br>distinct customers per market + powertrain · reach<br>study score · equipment today · competitor offer · trend<br>competitor signals = competitor evidence,<br>never counted as BMW customers"]
        S4["Tags: vehicles · scope · brand fit · segment<br>release fit current car / next gen / OTA, LLM from case size<br>AI proposes, PM can override"]
        S5["Conflict detector<br>market A negative, market B positive,<br>≥ N customers each → flag"]
        S6{"Open threshold reached, per vehicle?<br>customers · defect · competitor gap · removed feature<br>or PM opens by hand"}
        S7["Observed case<br>overview map only, keeps collecting"]
        S1 --> S2 --> S3 --> S4 --> S5 --> S6
        S6 -- "no" --> S7
    end

    %% ---------- 5. Case scoring ----------
    subgraph CS ["5 · Case importance score (no cost: a problem has no cost)"]
        direction TB
        P1["Factors 0..1<br>distinct customers · severity · reach capped<br>satisfaction gap · competitor gap · market volume 2030<br>removed vs predecessor · trend · brand fit<br>config source filter: skipped sources left out of the figures"]
        P2["Case score = weighted sum with weight profile<br>breakdown stored per version"]
        P1 --> P2
    end

    %% ---------- 6. PM works the case ----------
    subgraph PM ["6 · PM workspace: case board + case page (UI by teammate)"]
        direction TB
        U0["Notification toast<br>new open case · new evidence · conflict · run failed"]
        U1["Case board<br>ranked, drag = PM override with reason<br>filters: market · car area / category · state ·<br>source type · release fit"]
        U2["Case page, Notion-like<br>markdown body + structured fields<br>evidence: quotes → sources, score breakdown"]
        U3["RAG sidebar agent<br>answers with citations, compares markets,<br>proposes edits as diff → PM accepts"]
        U4{"PM confirms case<br>after meetings + discussion"}
        U0 --> U1 --> U2
        U2 <--> U3
        U2 --> U4
    end

    %% ---------- 7. Requirement generation ----------
    subgraph RQ ["7 · Requirement generation (only from confirmed cases)"]
        direction TB
        R1["Requirement agent<br>one requirement per confirmed case and BMW line,<br>split per market only if markets differ"]
        R2["Requirement page, Notion-like<br>description · metric + target · acceptance criteria<br>release target: next gen · current car · OTA<br>assumptions · evidence level · linked case"]
        R3["Cost<br>option price if exists, else AI S/M/L estimate<br>PM + engineers edit"]
        R1 --> R2 --> R3
    end

    %% ---------- 8. Requirement ranking + handover ----------
    subgraph HO ["8 · Requirement ranking, discussion with engineering, handover"]
        direction TB
        H1["Requirement rank<br>case score x cost multiplier S 1.0 · M 0.85 · L 0.7<br>board filters as on the case board"]
        H2["Edit · delete · re-target with engineers<br>RAG sidebar on requirement page too<br>delete = tombstone in audit"]
        H3{"PM approves requirement"}
        H4["Export top 10 (JSON / CSV now, logged)<br>codebeamer / Jira format later, with arguments:<br>complaint · wish · competition · cost"]
        H5["Requirement documentation<br>versioned, incl. rejected + reason"]
        H1 --> H2 --> H3
        H3 -- "yes" --> H4 --> H5
    end

    %% ---------- API (contract with the UI) ----------
    API["FastAPI + OpenAPI spec (UI contract)<br>Supabase Auth token → actor pm: / engineer: / admin:<br>PMs act only on their lines · stale save → 409<br>views + exports logged in the audit trail"]
    API <--> U1
    API <--> R2
    API <--> DB

    %% ---------- Storage + audit (cross-cutting) ----------
    DB[("Supabase Postgres + pgvector<br>source records · signals · features · cases ·<br>requirements · scores · decisions · embeddings")]
    AUDIT[("Audit event log, append-only<br>actor AI agent or PM · timestamp ·<br>object · before / after diff · rationale<br>incl. views + exports")]
    RAGIDX[("RAG index<br>case + requirement pages, signals, quotes,<br>snapshots, decisions, audit events")]

    %% ---------- Main flow ----------
    CFG --> SEED
    B7 -- "confirmed" --> DB
    CFG --> LOOP
    A1 & A2 & A3 & A4 --> SNAP
    SNAP --> J1
    J2 -- "valid" --> S1
    J2 -- "rejected" --> J3
    DB <--> S2
    S6 -- "yes" --> P1
    CF5 --> P2
    P2 --> U1
    S5 -. "conflict" .-> U0
    U4 -- "confirmed" --> R1
    U4 -- "not yet / rejected" --> U1
    R3 --> H1
    CF5 --> H1
    H3 -- "no / edit" --> H2
    H5 --> DB
    U2 -. "PM flags removed feature" .-> PRED
    PRED --> SNAP

    %% ---------- RAG wiring ----------
    DB --> RAGIDX
    AUDIT --> RAGIDX
    SNAP --> RAGIDX
    RAGIDX <--> U3

    %% ---------- Continuous loop ----------
    DB -. "daily: new evidence on confirmed case → flag, never auto-edit" .-> U0
    DB -. "next cycle" .-> LOOP

    %% ---------- Audit wiring ----------
    SEED -.-> AUDIT
    J3 -.-> AUDIT
    SC -.-> AUDIT
    CS -.-> AUDIT
    PM -.-> AUDIT
    RQ -.-> AUDIT
    HO -.-> AUDIT

    %% ---------- Styling ----------
    classDef ai fill:#e8f0fe,stroke:#1c69d4,color:#000
    classDef human fill:#fff4e5,stroke:#e08a00,color:#000
    classDef store fill:#eef7ee,stroke:#2e7d32,color:#000
    classDef gate fill:#fdecea,stroke:#c62828,color:#000
    class A1,A2,A3,A4,PRED,J1,S1,S2,S3,S4,S5,S7,P1,P2,R1,R2,R3,H1,U3 ai
    class U0,U1,U2,H2,H4,CF3,CF4,CF5,SRCNOTE human
    class DB,AUDIT,RAGIDX,SNAP,J3,J4 store
    class API ai
    class J2,B7,S6,U4,H3 gate
